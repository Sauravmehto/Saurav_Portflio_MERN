generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

/// Private contact-form submissions. Not shown on the site.
model Message {
  id        String   @id @default(cuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now())
}

/// Public guestbook. Only rows with approved = true are rendered.
model Note {
  id        String   @id @default(cuid())
  name      String
  message   String
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([approved, createdAt])
}

/// Hashed IP + kind, used to allow one submission per minute.
model RateLimit {
  id        String   @id @default(cuid())
  ipHash    String
  kind      String
  createdAt DateTime @default(now())

  @@index([ipHash, kind, createdAt])
}
