# Neon pooled connection string (hostname contains "-pooler").
# The app uses this at runtime. Direct (non-pooler) URLs exhaust connections on serverless.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require"

# Optional. When set, contact-form messages are also emailed via Resend.
# Saving still works if this is empty.
RESEND_API_KEY=""
# Verified sender, e.g. "Portfolio <hello@yourdomain.com>"
RESEND_FROM=""

# Absolute site URL for Open Graph and the sitemap. Falls back to localhost.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
